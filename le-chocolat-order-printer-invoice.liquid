<style>
  /* Le Chocolat presentation layer. The Order Printer Pro Liquid logic above is unchanged. */
  @page {
    margin-top: 9mm;
  }

  @page:first {
    margin-top: 7mm;
  }

  .template-1326887,
  .template-1326887 * {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif !important;
    color: #292929;
  }

  .template-1326887 {
    max-width: 760px;
    margin: 0 auto;
    padding: 24px 34px 0;
    min-height: 270mm;
    background: #fff;
  }

  .template-1326887 .page-shell {
    width: 100%;
    min-height: 270mm;
    border: 0;
    border-collapse: collapse;
    border-spacing: 0;
  }

  .template-1326887 .page-shell > thead {
